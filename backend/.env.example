# Application
APP_NAME=AI Research Assistant
DEBUG=true

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=

# PostgreSQL
DATABASE_URL=postgresql+psycopg://ai_research_app:CHANGE_ME@localhost:5432/ai_research_assistant

# ChromaDB & Embedding
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=research_documents
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base


# File Upload
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=20

# CORS
CORS_ORIGINS=http://localhost:5173